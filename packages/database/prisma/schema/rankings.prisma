// ============================================================================
// RANKING DOMAIN
// ----------------------------------------------------------------------------
// `RankingPointsEvent` is an append-only ledger — the source of truth.
// `RankingEntry` is a materialized "current standing" snapshot recomputable
// from the ledger at any time, mirroring the stats domain's rebuildability
// principle. Ranking rules are configurable per RankingSystem rather than
// one permanent points formula.
// ============================================================================

model RankingSystem {
  id            String     @id @default(uuid()) @db.Uuid
  name          String // e.g. "National Kumite Ranking"
  discipline    Discipline
  karateStyleId String?    @db.Uuid
  description   String?

  karateStyle KarateStyle?    @relation(fields: [karateStyleId], references: [id], onDelete: SetNull)
  seasons     RankingSeason[]

  @@map("ranking_systems")
}

model RankingSeason {
  id              String  @id @default(uuid()) @db.Uuid
  rankingSystemId String  @db.Uuid
  seasonId        String  @db.Uuid
  name            String?

  rankingSystem RankingSystem     @relation(fields: [rankingSystemId], references: [id], onDelete: Cascade)
  season        Season            @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  categories    RankingCategory[]

  @@unique([rankingSystemId, seasonId])
  @@map("ranking_seasons")
}

/// A ranked bucket within a ranking season, e.g. "Male -68kg U18".
model RankingCategory {
  id              String @id @default(uuid()) @db.Uuid
  rankingSeasonId String @db.Uuid
  label           String

  rankingSeason RankingSeason        @relation(fields: [rankingSeasonId], references: [id], onDelete: Cascade)
  entries       RankingEntry[]
  pointsEvents  RankingPointsEvent[]

  @@unique([rankingSeasonId, label])
  @@map("ranking_categories")
}

/// Materialized current standing — safe to drop and rebuild from RankingPointsEvent.
model RankingEntry {
  id                String   @id @default(uuid()) @db.Uuid
  rankingCategoryId String   @db.Uuid
  playerId          String   @db.Uuid
  points            Decimal  @default(0) @db.Decimal(10, 2)
  rank              Int?
  computedAt        DateTime @default(now())

  rankingCategory RankingCategory @relation(fields: [rankingCategoryId], references: [id], onDelete: Cascade)
  player          PlayerProfile   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([rankingCategoryId, playerId])
  @@map("ranking_entries")
}

/// Append-only ledger of every point award/adjustment. Source of truth for rankings.
model RankingPointsEvent {
  id                 String   @id @default(uuid()) @db.Uuid
  rankingCategoryId  String   @db.Uuid
  playerId           String   @db.Uuid
  points             Decimal  @db.Decimal(10, 2)
  reason             String
  sourceTournamentId String?  @db.Uuid
  occurredAt         DateTime @default(now())

  rankingCategory RankingCategory @relation(fields: [rankingCategoryId], references: [id], onDelete: Cascade)
  player          PlayerProfile   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([rankingCategoryId, playerId])
  @@map("ranking_points_events")
}

// ============================================================================
// BELT / GRADING DOMAIN
// ----------------------------------------------------------------------------
// Belt is a first-class, historical domain — never a `belt: string` column on
// Player. `PlayerBeltHistory` is append-only; `isCurrent` marks the active
// row per player. Certificates are their own entity so verification status
// and serial numbers are consistent whether the certificate came from a
// grading event or (later) a tournament result.
// ============================================================================

enum BeltGradeType {
  KYU
  DAN
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum CertificateType {
  BELT_GRADING
  TOURNAMENT_RESULT
  PARTICIPATION
}

model BeltSystem {
  id            String   @id @default(uuid()) @db.Uuid
  karateStyleId String   @db.Uuid
  name          String // e.g. "WKF Standard Kyu/Dan", "Academy-issued"
  description   String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  karateStyle   KarateStyle    @relation(fields: [karateStyleId], references: [id], onDelete: Restrict)
  grades        BeltGrade[]
  gradingEvents GradingEvent[]

  @@unique([karateStyleId, name])
  @@map("belt_systems")
}

model BeltGrade {
  id           String        @id @default(uuid()) @db.Uuid
  beltSystemId String        @db.Uuid
  name         String // e.g. "9th Kyu", "1st Dan"
  type         BeltGradeType
  rankOrder    Int // ascending order of progression, unique within a system
  colorName    String?
  colorHex     String?

  beltSystem  BeltSystem          @relation(fields: [beltSystemId], references: [id], onDelete: Restrict)
  beltHistory PlayerBeltHistory[]

  @@unique([beltSystemId, rankOrder])
  @@map("belt_grades")
}

/// A single grading session, hosted by an academy/organization, that can award
/// grades to multiple players.
model GradingEvent {
  id             String   @id @default(uuid()) @db.Uuid
  beltSystemId   String   @db.Uuid
  hostAcademyId  String?  @db.Uuid
  examinerUserId String?  @db.Uuid
  eventDate      DateTime
  location       String?
  notes          String?
  createdAt      DateTime @default(now())

  beltSystem  BeltSystem          @relation(fields: [beltSystemId], references: [id], onDelete: Restrict)
  hostAcademy Academy?            @relation(fields: [hostAcademyId], references: [id], onDelete: SetNull)
  awards      PlayerBeltHistory[]

  @@map("grading_events")
}

/// Append-only history of belt awards. Never update a past row in place;
/// insert a new row and flip `isCurrent`.
model PlayerBeltHistory {
  id                 String             @id @default(uuid()) @db.Uuid
  playerId           String             @db.Uuid
  beltGradeId        String             @db.Uuid
  gradingEventId     String?            @db.Uuid
  awardingAcademyId  String?            @db.Uuid
  examinerUserId     String?            @db.Uuid
  awardedDate        DateTime
  verificationStatus VerificationStatus @default(UNVERIFIED)
  certificateId      String?            @unique @db.Uuid
  isCurrent          Boolean            @default(true)
  createdAt          DateTime           @default(now())

  player       PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)
  beltGrade    BeltGrade     @relation(fields: [beltGradeId], references: [id], onDelete: Restrict)
  gradingEvent GradingEvent? @relation(fields: [gradingEventId], references: [id], onDelete: SetNull)
  certificate  Certificate?  @relation(fields: [certificateId], references: [id], onDelete: SetNull)

  @@index([playerId, isCurrent])
  @@map("player_belt_history")
}

model Certificate {
  id                 String             @id @default(uuid()) @db.Uuid
  type               CertificateType
  playerId           String?            @db.Uuid
  issuedByAcademyId  String?            @db.Uuid
  serialNumber       String             @unique
  verificationCode   String             @unique
  verificationStatus VerificationStatus @default(UNVERIFIED)
  fileUrl            String?
  issuedAt           DateTime           @default(now())

  beltHistoryEntry PlayerBeltHistory?

  @@index([playerId])
  @@map("certificates")
}

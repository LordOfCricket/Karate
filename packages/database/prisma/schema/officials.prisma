// ============================================================================
// OFFICIALS DOMAIN
// ----------------------------------------------------------------------------
// CRITICAL: OfficialFunction is NOT a login role. It is a per-tournament,
// per-tatami assignment attached to a ScorerProfile. The same scorer can be
// REFEREE at one tournament and TATAMI_MANAGER at the next — never store a
// function permanently on the user or scorer profile.
// ============================================================================

enum OfficialFunction {
  REFEREE
  JUDGE
  KANSA
  SCORE_SUPERVISOR
  TIMEKEEPER
  VIDEO_REVIEW_JUDGE
  TATAMI_MANAGER
}

enum TatamiStatus {
  INACTIVE
  ACTIVE
  PAUSED
  CLOSED
}

enum OfficialAssignmentStatus {
  ASSIGNED
  CONFIRMED
  DECLINED
  COMPLETED
  REVOKED
}

model Tatami {
  id           String       @id @default(uuid()) @db.Uuid
  tournamentId String       @db.Uuid
  label        String // e.g. "Tatami 1"
  status       TatamiStatus @default(INACTIVE)

  tournament          Tournament           @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  officialAssignments OfficialAssignment[]
  rounds              Round[]
  bouts               Bout[]

  @@unique([tournamentId, label])
  @@map("tatamis")
}

model OfficialAssignment {
  id               String                   @id @default(uuid()) @db.Uuid
  tournamentId     String                   @db.Uuid
  tatamiId         String?                  @db.Uuid
  scorerProfileId  String                   @db.Uuid
  function         OfficialFunction
  status           OfficialAssignmentStatus @default(ASSIGNED)
  assignedByUserId String                   @db.Uuid
  assignedAt       DateTime                 @default(now())

  tournament    Tournament    @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  tatami        Tatami?       @relation(fields: [tatamiId], references: [id], onDelete: SetNull)
  scorerProfile ScorerProfile @relation(fields: [scorerProfileId], references: [id], onDelete: Cascade)
  scoreEvents   ScoreEvent[]

  @@index([tournamentId, function])
  @@index([scorerProfileId])
  @@map("official_assignments")
}
